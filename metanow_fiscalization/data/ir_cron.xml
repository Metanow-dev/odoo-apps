<?xml version="1.0" encoding="utf-8"?>
<!-- XML IDs in this module are frozen for its life (BUILD_SPEC 10.1). Never rename one. -->
<odoo>
    <record id="ir_cron_metanow_fiscal_send" model="ir.cron">
        <field name="name">efis: dërgo faturat në radhë / send queued invoices</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_metanow_fiscal_send()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_metanow_fiscal_poll" model="ir.cron">
        <field name="name">efis: lexo gjendjen e faturave / read invoice states</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_metanow_fiscal_poll()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- DEV-2432: the payments on invoices whose payments changed, to efis's receivables. -->
    <record id="ir_cron_metanow_fiscal_payments" model="ir.cron">
        <field name="name">efis: dërgo pagesat e faturave / send invoice payments</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_metanow_fiscal_payments()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- DEV-2433: e-invoices suppliers sent, as draft vendor bills. -->
    <record id="ir_cron_metanow_fiscal_inbound" model="ir.cron">
        <field name="name">efis: lexo e-faturat e marra / read received e-invoices</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_metanow_fiscal_inbound()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
