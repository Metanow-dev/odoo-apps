<?xml version="1.0" encoding="utf-8"?>
<!-- XML IDs in this module are frozen for its life (BUILD_SPEC 10.1). Never rename one.

The footer carries what the law prints on an invoice (docs/research/printed_invoice_and_cash_register.md,
footer items 3 to 5): the registration code and the issuer security code as text, under the labels
the law uses, and the QR. The values are exactly what efis returned; nothing here computes one.
The QR is Odoo's own public barcode route at error correction M (BUILD_SPEC 10.4). -->
<odoo>
    <template id="report_invoice_document_metanow_fiscal" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='payment_term']" position="after">
            <div id="metanow_fiscal" class="mt-3" t-if="o.metanow_fiscal_security_code">
                <div class="row">
                    <div class="col-8">
                        <div t-if="o.metanow_fiscal_number">
                            <strong>Numri fiskal / Fiscal number:</strong>
                            <span t-field="o.metanow_fiscal_number"/>
                        </div>
                        <div t-if="o.metanow_fiscal_registration_code">
                            <strong>NIVF:</strong>
                            <span t-field="o.metanow_fiscal_registration_code"/>
                        </div>
                        <div>
                            <strong>NSLF:</strong>
                            <span t-field="o.metanow_fiscal_security_code"/>
                        </div>
                    </div>
                    <div class="col-4 text-end" t-if="o.metanow_fiscal_qr_src">
                        <img t-att-src="o.metanow_fiscal_qr_src" alt="QR" style="width: 30mm; height: 30mm;"/>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
