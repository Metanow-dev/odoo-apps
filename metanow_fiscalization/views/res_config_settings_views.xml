<?xml version="1.0" encoding="utf-8"?>
<!-- XML IDs in this module are frozen for its life (BUILD_SPEC 10.1). Never rename one. -->
<odoo>
    <record id="res_config_settings_view_form_metanow_fiscal" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.metanow_fiscal</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Fiskalizimi me efis / Fiscalisation with efis" name="metanow_fiscal_block">
                    <setting string="Fiskalizimi / Fiscalisation"
                             help="Faturat e klientëve fiskalizohen nga efis kur postohen. / Customer invoices are fiscalised by efis when they are posted.">
                        <field name="metanow_fiscal_enabled"/>
                    </setting>
                    <setting string="Fatura elektronike / E-invoices"
                             help="Një faturë pa para në dorë për një blerës me numër tatimor dërgohet si faturë elektronike. / A non-cash invoice to a buyer with a tax number is sent as an e-invoice.">
                        <field name="metanow_fiscal_einvoice"/>
                    </setting>
                    <!-- DEV-2433 -->
                    <setting string="E-faturat e marra / Received e-invoices"
                             help="Çdo e-faturë që një furnitor i dërgon biznesit bëhet një faturë furnitori në draft, me PDF-në. Rreshtat shkruhen nga PDF-ja. / Each e-invoice a supplier sends the business becomes a draft vendor bill, with its PDF. The lines are entered from the PDF.">
                        <field name="metanow_fiscal_inbound_enabled"/>
                        <div class="content-group" invisible="not metanow_fiscal_inbound_enabled">
                            <div class="row mt8">
                                <label for="metanow_fiscal_inbound_since" class="col-lg-4 o_light_label"/>
                                <field name="metanow_fiscal_inbound_since"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Lidhja me efis / Connection to efis" groups="base.group_system">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="metanow_fiscal_api_url" class="col-lg-4 o_light_label"/>
                                <field name="metanow_fiscal_api_url"/>
                            </div>
                            <div class="row mt8">
                                <label for="metanow_fiscal_tenant" class="col-lg-4 o_light_label"/>
                                <field name="metanow_fiscal_tenant"/>
                            </div>
                            <div class="row mt8">
                                <label for="metanow_fiscal_channel" class="col-lg-4 o_light_label"/>
                                <field name="metanow_fiscal_channel"/>
                            </div>
                            <div class="row mt8">
                                <label for="metanow_fiscal_pairing_code" class="col-lg-4 o_light_label"/>
                                <field name="metanow_fiscal_pairing_code"/>
                            </div>
                            <div class="mt8">
                                <!-- "execute" is the settings save: it runs set_values, which
                                     exchanges the code, without the unsaved-changes dialog. -->
                                <button name="execute" type="object" class="btn-link"
                                        icon="oi-arrow-right"
                                        string="Çifto me efis / Pair with efis"/>
                                <button name="action_metanow_fiscal_refresh_profile" type="object" class="btn-link"
                                        icon="oi-arrow-right"
                                        string="Kontrollo konfigurimin / Check the configuration"/>
                            </div>
                        </div>
                    </setting>
                    <!-- DEV-1704 -->
                    <setting string="Njoftimet nga efis / Events from efis" groups="base.group_system"
                             invisible="not metanow_fiscal_tenant"
                             help="efis njofton Odoo kur një faturë ndryshon gjendje, kur zëvendësohet nga një korrigjim ose kur certifikata po skadon. Odoo lexon përsëri nga efis. / efis tells Odoo when an invoice changes state, when a correction replaces it, or when the certificate is running out. Odoo reads it again from efis.">
                        <div class="content-group">
                            <div class="alert alert-warning mt8" role="alert" invisible="not metanow_fiscal_certificate_notice">
                                <field name="metanow_fiscal_certificate_notice"/>
                            </div>
                            <div class="mt8" invisible="not metanow_fiscal_webhook_status">
                                <field name="metanow_fiscal_webhook_status" style="white-space: pre-wrap;"/>
                            </div>
                            <div class="mt8">
                                <button name="action_metanow_fiscal_register_webhook" type="object" class="btn-link"
                                        icon="oi-arrow-right"
                                        string="Regjistro përsëri te efis / Register with efis again"/>
                            </div>
                        </div>
                    </setting>
                    <!-- DEV-2443 -->
                    <setting string="Rikthe të dhënat nga efis / Restore from efis" groups="base.group_system"
                             invisible="not metanow_fiscal_tenant"
                             help="Pas riinstalimit të modulit, lexon nga efis numrat fiskalë dhe kodet e faturave që i humbën, dhe i bllokon përsëri. Nuk dërgon asgjë. / After the module is reinstalled, reads from efis the fiscal numbers and codes of the invoices that lost them, and locks them again. It sends nothing.">
                        <field name="metanow_fiscal_restore_pending" invisible="1"/>
                        <div class="content-group">
                            <div class="mt8" invisible="not metanow_fiscal_restore_summary">
                                <field name="metanow_fiscal_restore_summary" style="white-space: pre-wrap;"/>
                            </div>
                            <div class="mt8">
                                <button name="action_metanow_fiscal_restore" type="object" class="btn-link"
                                        icon="oi-arrow-right" invisible="metanow_fiscal_restore_pending"
                                        string="Rikthe të dhënat nga efis / Restore from efis"/>
                                <button name="action_metanow_fiscal_restore_skipped" type="object" class="btn-link"
                                        icon="oi-arrow-right"
                                        string="Faturat e lëna mënjanë / Invoices left alone"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Kodet e regjistrimit / Registration codes">
                        <div class="content-group">
                            <!-- DEV-2436: the codes come from efis's registry; a stored code efis does
                                 not confirm, or a registry not read yet, is said here. -->
                            <div class="alert alert-warning mt8" role="alert"
                                 invisible="not metanow_fiscal_registry_notice">
                                <field name="metanow_fiscal_registry_notice"/>
                            </div>
                            <div class="row mt8">
                                <label for="metanow_fiscal_vat_status" class="col-lg-4 o_light_label"/>
                                <field name="metanow_fiscal_vat_status"/>
                            </div>
                            <div class="row mt8">
                                <label for="metanow_fiscal_business_unit_code_pick" class="col-lg-4 o_light_label"/>
                                <field name="metanow_fiscal_business_unit_code_pick"/>
                            </div>
                            <div class="row mt8">
                                <label for="metanow_fiscal_operator_code_pick" class="col-lg-4 o_light_label"/>
                                <field name="metanow_fiscal_operator_code_pick"/>
                            </div>
                            <div class="row mt8">
                                <label for="metanow_fiscal_software_code_pick" class="col-lg-4 o_light_label"/>
                                <field name="metanow_fiscal_software_code_pick"/>
                            </div>
                            <div class="row mt8">
                                <label for="metanow_fiscal_device_code_pick" class="col-lg-4 o_light_label"/>
                                <field name="metanow_fiscal_device_code_pick"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
