<?xml version="1.0" encoding="utf-8"?>
<!-- XML IDs in this module are frozen for its life (BUILD_SPEC 10.1). Never rename one. -->
<odoo>
    <!-- DEV-2436: the operator code this person issues under, for the current company. -->
    <record id="view_users_form_metanow_fiscal" model="ir.ui.view">
        <field name="name">res.users.form.metanow_fiscal</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="efis" name="metanow_fiscal">
                    <group>
                        <field name="metanow_fiscal_operator_code"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
