<?xml version="1.0" encoding="utf-8"?>
<!-- XML IDs in this module are frozen for its life (BUILD_SPEC 10.1). Never rename one. -->
<odoo>
    <record id="ir_cron_metanow_fiscal_pos_send" model="ir.cron">
        <field name="name">efis: dërgo lëvizjet e arkës POS / send POS cash movements</field>
        <field name="model_id" ref="point_of_sale.model_pos_session"/>
        <field name="state">code</field>
        <field name="code">model._cron_metanow_fiscal_pos_send()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_metanow_fiscal_pos_poll" model="ir.cron">
        <field name="name">efis: lexo gjendjen e lëvizjeve të arkës POS / read POS cash movement states</field>
        <field name="model_id" ref="point_of_sale.model_pos_session"/>
        <field name="state">code</field>
        <field name="code">model._cron_metanow_fiscal_pos_poll()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
