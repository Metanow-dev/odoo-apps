<?xml version="1.0" encoding="utf-8"?>
<!-- XML IDs in this module are frozen for its life (BUILD_SPEC 10.1). Never rename one. -->
<odoo>
    <record id="ir_cron_metanow_fiscal_wtn_send" model="ir.cron">
        <field name="name">efis: dërgo faturat shoqëruese / send transfer notes</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">model._cron_metanow_fiscal_wtn_send()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_metanow_fiscal_wtn_poll" model="ir.cron">
        <field name="name">efis: lexo gjendjen e faturave shoqëruese / read transfer note states</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">model._cron_metanow_fiscal_wtn_poll()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
