<?xml version="1.0" encoding="utf-8"?>
<!-- XML IDs in this module are frozen for its life (BUILD_SPEC 10.1). Never rename one. -->
<odoo>
    <record id="view_picking_type_form_metanow_fiscal" model="ir.ui.view">
        <field name="name">stock.picking.type.form.metanow_fiscal</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sequence_code']" position="after">
                <field name="metanow_fiscal_wtn_transaction" invisible="metanow_fiscal_ti_transaction"/>
                <!-- DEV-2430: or a transport invoice; never both. -->
                <field name="metanow_fiscal_ti_transaction" invisible="metanow_fiscal_wtn_transaction"/>
            </xpath>
        </field>
    </record>
</odoo>
