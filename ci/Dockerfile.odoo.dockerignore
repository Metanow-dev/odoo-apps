# BuildKit uses this file instead of the root .dockerignore when building ci/Dockerfile.odoo
# (and only then). It is the root list without dist/: this image copies the module from
# dist/odoo/addons, which the package job unpacked.
.git/
**/__pycache__/
**/*.pyc

secrets/
**/*.pfx
**/*.p12
**/*.pem
**/*.key
**/*.password
.env
**/.env
